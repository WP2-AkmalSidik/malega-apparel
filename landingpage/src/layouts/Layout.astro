---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
}

const {
  title = "MALEGA APPAREL — Modern Clothing & Lifestyle Essentials",
  description = "Official Malega Apparel Atelier. Contemporary fashion label crafted for everyday movement, refined modest essentials, tailored silhouettes, and lasting craftsmanship.",
  image = "/img/malega-brand.png",
  canonicalURL = "https://malega-apparel.com"
} = Astro.props;

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://malega-apparel.com/#organization",
      "name": "MALEGA APPAREL",
      "url": "https://malega-apparel.com",
      "logo": {
        "@type": "ImageObject",
        "url": "https://malega-apparel.com/img/malega-brand.png",
        "caption": "MALEGA APPAREL Official Brand Identity"
      },
      "sameAs": [
        "https://instagram.com/malega.apparel",
        "https://tiktok.com/@malega.apparel"
      ]
    },
    {
      "@type": "Brand",
      "@id": "https://malega-apparel.com/#brand",
      "name": "MALEGA APPAREL",
      "description": "Modern Apparel & Lifestyle Brand specializing in casual wear, modest fashion, daily essentials, and premium apparel.",
      "url": "https://malega-apparel.com"
    }
  ]
};
---

<!DOCTYPE html>
<html lang="id" class="scroll-smooth bg-[#0B132B]">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <link rel="icon" type="image/png" href="/img/malega-brand.png" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0B132B" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content="Malega Apparel, Modern Apparel, Modest Fashion, Koko Modern, Daily Essentials, Kaos Boxy, Contemporary Clothing, Premium Basics Indonesia" />
    <meta name="author" content="Malega Apparel" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="MALEGA APPAREL" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:alt" content="MALEGA APPAREL - Modern Clothing & Lifestyle Essentials" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    <!-- Google Fonts (Plus Jakarta Sans: 400, 500, 600, 700) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- JSON-LD SEO Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body class="bg-[#0B132B] text-[#FDFCFF] min-h-screen antialiased selection:bg-[#CBAC70] selection:text-[#0B132B] overflow-x-hidden font-sans">
    <slot />
  </body>
</html>
