---
const lookbookItems = [
  {
    look: "LOOK 01 : ALL-BLACK OBSIDIAN",
    model: "Obsidian Boxy Tee 300GSM + Ripstop Cargo",
    image: "https://images.unsplash.com/photo-1503342217505-b0a15ec3261c?w=900&auto=format&fit=crop&q=80",
    href: "http://localhost:3000/products/mlg-001"
  },
  {
    look: "LOOK 02 : FLEECE COLD LAYER",
    model: "French Terry Hoodie 380GSM + Selvedge Denim",
    image: "https://images.unsplash.com/photo-1556905055-8f358a7a47b2?w=900&auto=format&fit=crop&q=80",
    href: "http://localhost:3000/products/mlg-002"
  },
  {
    look: "LOOK 03 : MONOCHROME ESSENTIALS",
    model: "Sand Khaki 300GSM Tee + Gold Monogram Cap",
    image: "https://images.unsplash.com/photo-1521572267360-ee0c2909d518?w=900&auto=format&fit=crop&q=80",
    href: "http://localhost:3000/products/mlg-001"
  }
];
---

<section id="lookbook" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24 space-y-10">
  
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-white/10 pb-4">
    <div class="space-y-1">
      <span class="text-xs font-bold text-[#CBAC70] uppercase tracking-widest font-mono">SEASON 2026 EDITORIAL</span>
      <h2 class="text-2xl sm:text-4xl font-black text-[#FDFCFF] uppercase tracking-wide">
        Official Streetwear Lookbook
      </h2>
    </div>
    <a href="http://localhost:3000" class="text-xs font-bold text-[#CBAC70] hover:underline flex items-center gap-1">
      <span>Belanja Keseluruhan Look di Store</span>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 12h14"></path>
        <path d="m12 5 7 7-7 7"></path>
      </svg>
    </a>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    {lookbookItems.map((item) => (
      <div class="group rounded-3xl bg-gradient-to-b from-[#14204A] via-[#0E1736] to-[#0A1024] p-2.5 border border-[#CBAC70]/25 hover:border-[#CBAC70]/70 transition-all duration-300 shadow-xl flex flex-col justify-between">
        
        <div class="rounded-2xl bg-[#070D1F] border border-white/10 overflow-hidden relative aspect-[3/4]">
          <img
            src={item.image}
            alt={item.look}
            class="w-full h-full object-cover group-hover:scale-106 transition-transform duration-700 ease-out"
            loading="lazy"
            width="600"
            height="800"
          />

          <div class="absolute inset-0 bg-gradient-to-t from-[#0B132B] via-[#0B132B]/30 to-transparent opacity-85 group-hover:opacity-75 transition-opacity" />

          <div class="absolute inset-0 p-6 flex flex-col justify-end space-y-2">
            <span class="text-[10px] font-mono text-[#CBAC70] font-bold uppercase tracking-widest">
              {item.look}
            </span>
            <h3 class="text-base font-black text-[#FDFCFF] leading-snug">
              {item.model}
            </h3>
            
            <div class="pt-2">
              <a
                href={item.href}
                class="inline-flex items-center gap-1.5 px-4 py-2 bg-[#CBAC70] text-[#0B132B] text-xs font-black uppercase tracking-wider rounded-xl hover:bg-[#E3CD99] transition-all shadow-md active:scale-95"
              >
                <span>Beli Look Ini</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14"></path>
                  <path d="m12 5 7 7-7 7"></path>
                </svg>
              </a>
            </div>
          </div>

        </div>

      </div>
    ))}
  </div>

</section>
