---
const collections = [
  {
    title: "Heavyweight Boxy Tees",
    subtitle: "300GSM 100% Combed Cotton",
    tag: "300GSM HEAVY",
    price: "Mulai Rp 229.000",
    image: "https://images.unsplash.com/photo-1521572267360-ee0c2909d518?w=800&auto=format&fit=crop&q=80",
    href: "http://localhost:3000/katalog/heavyweight-boxy-tees-300gsm"
  },
  {
    title: "French Terry Hoodies",
    subtitle: "380GSM Heavyweight Fleece",
    tag: "380GSM FLEECE",
    price: "Mulai Rp 389.000",
    image: "https://images.unsplash.com/photo-1556905055-8f358a7a47b2?w=800&auto=format&fit=crop&q=80",
    href: "http://localhost:3000/katalog/french-terry-outerwear-series"
  },
  {
    title: "Utility Cargo & Denim",
    subtitle: "Ripstop & 14oz Raw Selvedge",
    tag: "TACTICAL RAW",
    price: "Mulai Rp 319.000",
    image: "https://images.unsplash.com/photo-1624378439575-d8705ad7ae80?w=800&auto=format&fit=crop&q=80",
    href: "http://localhost:3000/katalog/tactical-utility-bottoms"
  },
  {
    title: "Atelier Caps & Bags",
    subtitle: "Gold Monogram & Cordura",
    tag: "GOLD EMBROIDERY",
    price: "Mulai Rp 129.000",
    image: "https://images.unsplash.com/photo-1588850561407-ed78c282e89b?w=800&auto=format&fit=crop&q=80",
    href: "http://localhost:3000/katalog/atelier-luxury-accessories"
  }
];
---

<section id="koleksi" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24 space-y-10">
  
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-white/10 pb-4">
    <div class="space-y-1">
      <span class="text-xs font-bold text-[#CBAC70] uppercase tracking-widest font-mono">Curated Disciplines</span>
      <h2 class="text-2xl sm:text-4xl font-black text-[#FDFCFF] uppercase tracking-wide">
        Katalog Seri Koleksi
      </h2>
    </div>
    <a href="http://localhost:3000/katalog" class="text-xs font-bold text-[#CBAC70] hover:underline flex items-center gap-1">
      <span>Lihat Direktori Katalog Lengkap</span>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 12h14"></path>
        <path d="m12 5 7 7-7 7"></path>
      </svg>
    </a>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
    {collections.map((item) => (
      <div class="group rounded-3xl bg-gradient-to-b from-[#14204A] via-[#0E1736] to-[#0A1024] p-2.5 border border-[#CBAC70]/25 hover:border-[#CBAC70]/70 transition-all duration-300 shadow-xl hover:shadow-[#CBAC70]/15 flex flex-col justify-between">
        
        <div class="rounded-2xl bg-[#070D1F] border border-white/10 overflow-hidden flex flex-col justify-between h-full">
          
          <!-- Image -->
          <div class="relative aspect-[4/5] bg-[#050914] overflow-hidden">
            <img
              src={item.image}
              alt={item.title}
              class="w-full h-full object-cover group-hover:scale-106 transition-transform duration-700 ease-out"
              loading="lazy"
              width="600"
              height="750"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#070D1F] via-transparent to-transparent opacity-80" />

            <div class="absolute top-3 left-3">
              <span class="bg-[#CBAC70] text-[#0B132B] text-[9px] font-black tracking-widest uppercase px-2.5 py-0.5 rounded shadow">
                {item.tag}
              </span>
            </div>
          </div>

          <!-- Content -->
          <div class="p-4 sm:p-5 space-y-3">
            <div>
              <h3 class="font-black text-sm sm:text-base text-[#FDFCFF] group-hover:text-[#CBAC70] transition-colors leading-snug">
                {item.title}
              </h3>
              <p class="text-xs text-[#94A3B8] mt-0.5">{item.subtitle}</p>
            </div>

            <div class="pt-3 border-t border-white/10 flex items-center justify-between">
              <span class="text-xs font-black text-[#CBAC70]">{item.price}</span>
              <a
                href={item.href}
                class="px-3 py-1.5 rounded-lg bg-[#14204A] hover:bg-[#CBAC70] text-[#CBAC70] hover:text-[#0B132B] text-[11px] font-bold transition-all shadow"
              >
                Lihat Seri →
              </a>
            </div>
          </div>

        </div>

      </div>
    ))}
  </div>

</section>
