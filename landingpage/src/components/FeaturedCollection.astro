---

<section id="featured" class="py-24 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
      <div>
        <span class="text-xs font-bold text-amber-400 uppercase tracking-widest block mb-2 font-mono">Curated Drops</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white font-['Space_Grotesk'] tracking-tight">
          Featured Apparel <span class="accent-gradient">Collection</span>
        </h2>
      </div>
      <p class="text-sm text-slate-400 max-w-md">
        Setiap artikel diproduksi dalam kuantitas terbatas guna menjaga eksklusivitas, presisi cutting, dan standar detail premium.
      </p>
    </div>

    <!-- Products Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {products.map((item) => (
        <div class="group glass-panel rounded-2xl overflow-hidden hover:border-slate-600 transition-all duration-300 flex flex-col justify-between">
          
          <!-- Card Image & Silhouette Box -->
          <div class="aspect-[4/3] bg-gradient-to-b from-slate-900 via-slate-950 to-slate-900 p-6 flex flex-col justify-between relative overflow-hidden">
            <div class="flex justify-between items-center z-10">
              <span class={`text-[10px] font-bold px-2.5 py-1 rounded-full uppercase tracking-wider ${item.badgeColor}`}>
                {item.badge}
              </span>
              <span class="text-[11px] font-mono text-slate-500">{item.id}</span>
            </div>

            <!-- Visual Icon/Graphic -->
            <div class="my-auto text-center transform group-hover:scale-105 transition-transform duration-300">
              <div class="w-16 h-16 mx-auto rounded-2xl bg-slate-800/80 border border-slate-700 flex items-center justify-center text-amber-400 group-hover:border-amber-500/50 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
                </svg>
              </div>
            </div>

            <div class="z-10 text-[11px] text-slate-400 font-medium flex justify-between items-center">
              <span>{item.color}</span>
              <span>{item.category}</span>
            </div>
          </div>

          <!-- Card Content -->
          <div class="p-6 flex flex-col justify-between flex-1 space-y-4">
            <div>
              <h3 class="text-lg font-bold text-white group-hover:text-amber-400 transition-colors font-['Space_Grotesk']">
                {item.name}
              </h3>
              <p class="text-xs text-slate-400 mt-1">{item.specs}</p>
            </div>

            <div class="pt-4 border-t border-slate-800 flex items-center justify-between">
              <div>
                <span class="text-xs text-slate-500 line-through mr-2">{item.oldPrice}</span>
                <span class="text-base font-extrabold text-amber-400 font-['Space_Grotesk']">{item.price}</span>
              </div>
              <button class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-amber-400 hover:text-black text-slate-200 text-xs font-bold transition-all duration-200 shadow">
                Order via WA
              </button>
            </div>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
