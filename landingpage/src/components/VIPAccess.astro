<section id="vip" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24">
  
  <div class="rounded-3xl bg-gradient-to-br from-[#14204A] via-[#0B132B] to-[#1C2541] border border-[#CBAC70]/40 p-8 sm:p-14 text-center space-y-6 shadow-2xl relative overflow-hidden">
    
    <!-- Ambient Gold Glow -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-80 h-80 bg-[#CBAC70]/10 blur-[120px] rounded-full pointer-events-none"></div>

    <div class="inline-block px-4 py-1.5 rounded-full bg-[#CBAC70]/15 border border-[#CBAC70]/40 text-[#CBAC70] text-xs font-bold font-mono tracking-widest uppercase">
      EXCLUSIVE VIP PRIVILEGE
    </div>

    <div class="space-y-2 max-w-2xl mx-auto">
      <h2 class="text-3xl sm:text-5xl font-black text-[#FDFCFF] tracking-tight uppercase">
        Join the <span class="gold-gradient-pure">Malega VIP Circle</span>
      </h2>
      <p class="text-xs sm:text-sm text-[#94A3B8] leading-relaxed">
        Nikmati potongan voucher 15% untuk pembelian pertama Anda di Official Storefront dengan menggunakan kode promo eksklusif di bawah ini.
      </p>
    </div>

    <!-- Voucher Code Box -->
    <div class="max-w-md mx-auto p-4 rounded-2xl bg-[#070D1F] border border-[#CBAC70]/40 flex items-center justify-between shadow-inner">
      <div class="text-left space-y-0.5">
        <span class="text-[10px] text-[#94A3B8] uppercase font-mono block">Kode Voucher 15% OFF:</span>
        <span class="font-mono text-lg font-black text-[#CBAC70] tracking-wider">MALEGAVIP15</span>
      </div>
      <a
        href="http://localhost:3000"
        class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-[#E3CD99] via-[#CBAC70] to-[#A58645] text-[#0B132B] font-black text-xs uppercase tracking-wider hover:opacity-95 transition-all shadow active:scale-95"
      >
        Gunakan di Store →
      </a>
    </div>

    <div class="flex items-center justify-center gap-6 text-xs text-[#94A3B8] pt-2">
      <span class="flex items-center gap-1.5 text-[#CBAC70]">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        <span>100% Original Guarantee</span>
      </span>
      <span class="flex items-center gap-1.5 text-emerald-400">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 17h4V5H10z"/><path d="M20 17h2v-3.34a4 4 0 0 0-1.17-2.83L19 9h-5v8h2"/><path d="M14 17h1"/><path d="M4 17H2V9h12"/><circle cx="7" cy="17" r="2"/><circle cx="17" cy="17" r="2"/></svg>
        <span>Gratis Ongkir XTRA</span>
      </span>
    </div>

  </div>

</section>
