<header class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-4">
    <div class="glass-nav rounded-2xl px-6 py-3.5 flex items-center justify-between shadow-2xl">
      <!-- Brand Logo -->
      <a href="#" class="flex items-center gap-3 group">
        <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-amber-500 via-orange-600 to-red-600 flex items-center justify-center font-extrabold text-black text-lg shadow-lg group-hover:scale-105 transition-transform duration-200">
          M
        </div>
        <div class="flex flex-col">
          <span class="text-xl font-extrabold tracking-wider text-white font-['Space_Grotesk']">MALEGA</span>
          <span class="text-[10px] tracking-[0.25em] text-amber-400 font-semibold uppercase -mt-1">Apparel</span>
        </div>
      </a>

      <!-- Desktop Nav Links -->
      <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-slate-300">
        <a href="#collections" class="hover:text-amber-400 transition-colors duration-200">Koleksi</a>
        <a href="#featured" class="hover:text-amber-400 transition-colors duration-200">New Drops</a>
        <a href="#lookbook" class="hover:text-amber-400 transition-colors duration-200">Lookbook</a>
        <a href="#brand" class="hover:text-amber-400 transition-colors duration-200">Craftsmanship</a>
      </nav>

      <!-- Action Buttons -->
      <div class="flex items-center gap-3">
        <a 
          href="http://localhost:8000" 
          target="_blank"
          rel="noopener noreferrer"
          class="hidden sm:inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl text-xs font-semibold text-slate-300 hover:text-white border border-slate-700/80 hover:border-slate-500 bg-slate-900/60 transition-all duration-200"
          title="Buka Backoffice Admin Laravel"
        >
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          Backoffice Portal
        </a>
        <a 
          href="#collections" 
          class="inline-flex items-center justify-center px-4 py-2 rounded-xl text-xs font-bold text-black bg-gradient-to-r from-amber-400 to-amber-500 hover:from-amber-300 hover:to-amber-400 shadow-md hover:shadow-amber-500/20 transition-all duration-200 transform active:scale-95"
        >
          Shop Now
        </a>
      </div>
    </div>
  </div>
</header>
