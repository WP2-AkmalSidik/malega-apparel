---

<header class="sticky top-0 z-50 glass-nav transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 sm:h-20 flex items-center justify-between gap-6">
    
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2.5 group cursor-pointer">
      <img
        src="/img/malega-brand.png"
        alt="MALEGA APPAREL Official Logo"
        class="h-8 sm:h-11 w-auto object-contain drop-shadow-md brightness-105 group-hover:opacity-90 transition-opacity"
        loading="eager"
        width="160"
        height="44"
      />
    </a>

    <!-- Navigation Links -->
    <nav class="hidden md:flex items-center gap-8 text-xs font-bold uppercase tracking-[0.18em] text-[#94A3B8]">
      <a href="#koleksi" class="hover:text-[#CBAC70] transition-colors py-1">Koleksi</a>
      <a href="#craftsmanship" class="hover:text-[#CBAC70] transition-colors py-1">Craftsmanship</a>
      <a href="#lookbook" class="hover:text-[#CBAC70] transition-colors py-1">Lookbook</a>
      <a href="#vip" class="hover:text-[#CBAC70] transition-colors py-1">VIP Privilege</a>
    </nav>

    <!-- Direct Storefront CTA -->
    <div class="flex items-center gap-3">
      <a 
        href="http://localhost:3000" 
        class="px-4 sm:px-5 py-2 sm:py-2.5 rounded-xl bg-gradient-to-r from-[#E3CD99] via-[#CBAC70] to-[#A58645] hover:opacity-95 text-[#0B132B] font-black text-xs uppercase tracking-wider transition-all shadow-lg active:scale-95 flex items-center gap-1.5"
      >
        <span>Belanja di Store</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </a>
    </div>

  </div>
</header>
