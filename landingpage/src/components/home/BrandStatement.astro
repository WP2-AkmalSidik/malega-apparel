---
---

<section id="statement" class="py-24 sm:py-32 bg-[#0B132B] relative">
  <div class="max-w-[1440px] mx-auto px-6 sm:px-8 lg:px-12">
    
    <div class="max-w-4xl mx-auto text-center space-y-8">
      
      <!-- Eyebrow -->
      <div class="inline-flex items-center justify-center gap-3">
        <span class="w-6 h-[1px] bg-[#CBAC70]"></span>
        <span class="text-[11px] font-semibold tracking-[0.25em] text-[#CBAC70] uppercase">
          Brand Philosophy
        </span>
        <span class="w-6 h-[1px] bg-[#CBAC70]"></span>
      </div>

      <!-- Large Editorial Statement -->
      <h2 class="text-3xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-[#FDFCFF] leading-[1.15]">
        More Than What You Wear. <br />
        <span class="text-[#8E9BAE] font-normal">A reflection of how you move.</span>
      </h2>

      <!-- Refined Description Paragraph -->
      <p class="text-base sm:text-lg text-[#8E9BAE] leading-relaxed max-w-2xl mx-auto font-normal">
        Malega Apparel lahir dari keyakinan bahwa pakaian harus membebaskan, bukan membatasi. Dari kaos bergramasi kokoh, kemeja potongan santai, hingga siluet koko kontemporer — setiap helai dirancang untuk menyatu secara natural dalam ragam momen kehidupan.
      </p>

      <!-- Signature Divider Line with Gold Diamond Accent -->
      <div class="pt-6 flex items-center justify-center gap-3">
        <div class="w-16 h-[1px] bg-[#CBAC70]/30"></div>
        <div class="w-1.5 h-1.5 rotate-45 bg-[#CBAC70]"></div>
        <div class="w-16 h-[1px] bg-[#CBAC70]/30"></div>
      </div>

    </div>

  </div>
</section>
