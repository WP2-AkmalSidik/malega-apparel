---
---

<section id="statement" class="py-16 sm:py-24 lg:py-32 bg-[#0B132B] relative">
  <div class="max-w-[1440px] mx-auto px-5 sm:px-8 lg:px-12">
    
    <div class="max-w-4xl mx-auto text-center space-y-5 sm:space-y-8">
      
      <!-- Eyebrow -->
      <div class="inline-flex items-center justify-center gap-2.5 sm:gap-3">
        <span class="w-5 sm:w-6 h-[1px] bg-[#CBAC70]"></span>
        <span class="text-[10px] sm:text-[11px] font-semibold tracking-[0.25em] text-[#CBAC70] uppercase">
          Brand Philosophy
        </span>
        <span class="w-5 sm:w-6 h-[1px] bg-[#CBAC70]"></span>
      </div>

      <!-- Large Editorial Statement -->
      <h2 class="text-2xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-[#FDFCFF] leading-[1.2]">
        More Than What You Wear. <br />
        <span class="text-[#8E9BAE] font-normal">A reflection of how you move.</span>
      </h2>

      <!-- Refined Description Paragraph -->
      <p class="text-xs sm:text-base text-[#8E9BAE] leading-relaxed max-w-2xl mx-auto font-normal">
        Malega Apparel lahir dari keyakinan bahwa pakaian harus membebaskan, bukan membatasi. Dari kaos bergramasi kokoh, kemeja potongan santai, hingga siluet koko kontemporer — setiap helai dirancang untuk menyatu secara natural dalam ragam momen kehidupan.
      </p>

      <!-- Signature Divider Line with Gold Diamond Accent -->
      <div class="pt-3 sm:pt-6 flex items-center justify-center gap-3">
        <div class="w-12 sm:w-16 h-[1px] bg-[#CBAC70]/30"></div>
        <div class="w-1.5 h-1.5 rotate-45 bg-[#CBAC70]"></div>
        <div class="w-12 sm:w-16 h-[1px] bg-[#CBAC70]/30"></div>
      </div>

    </div>

  </div>
</section>
