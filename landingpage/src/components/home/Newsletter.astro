---
---

<section class="py-24 sm:py-32 bg-[#0B132B] relative border-t border-[#CBAC70]/10">
  <div class="max-w-[1440px] mx-auto px-6 sm:px-8 lg:px-12">
    
    <div class="max-w-2xl mx-auto text-center space-y-8 p-8 sm:p-12 rounded-sm bg-[#0E1736]/50 border border-[#CBAC70]/20">
      
      <!-- Eyebrow -->
      <span class="text-[11px] font-semibold text-[#CBAC70] uppercase tracking-[0.25em] block">
        VIP ACCESS & JOURNAL
      </span>

      <!-- Title & Subtitle -->
      <div class="space-y-3">
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-[#FDFCFF]">
          Stay in the Malega Circle.
        </h2>
        <p class="text-xs sm:text-sm text-[#8E9BAE] leading-relaxed max-w-lg mx-auto font-normal">
          Dapatkan akses prioritas terhadap rilisan kapsul terbaru, artikel jurnal busana, dan kurasi eksklusif langsung di kotak masuk Anda.
        </p>
      </div>

      <!-- Semantic Form -->
      <form id="newsletter-form" class="max-w-md mx-auto space-y-3" onsubmit="event.preventDefault(); document.getElementById('newsletter-success').classList.remove('hidden'); document.getElementById('newsletter-form').reset();">
        <div class="flex flex-col sm:flex-row gap-2.5">
          <input
            type="email"
            name="email"
            required
            placeholder="Alamat email Anda..."
            aria-label="Email address for Malega Circle newsletter"
            class="flex-1 px-4 py-3.5 bg-[#0B132B] border border-[#CBAC70]/25 rounded-sm text-xs text-[#FDFCFF] placeholder-[#8E9BAE]/60 focus:outline-none focus:border-[#CBAC70] transition-colors"
          />
          <button
            type="submit"
            class="px-7 py-3.5 bg-[#CBAC70] hover:bg-[#E6D3A7] text-[#0B132B] font-semibold text-xs uppercase tracking-[0.2em] rounded-sm transition-all duration-300 shadow-sm shrink-0 active:scale-98 cursor-pointer"
          >
            Join
          </button>
        </div>

        <p class="text-[11px] text-[#8E9BAE]/70 text-left sm:text-center">
          Kami menghargai privasi Anda. Berhenti berlangganan kapan saja dengan satu klik.
        </p>

        <!-- Accessible Success Message -->
        <div id="newsletter-success" class="hidden p-3 bg-[#CBAC70]/10 border border-[#CBAC70]/30 rounded-sm text-xs text-[#CBAC70] font-medium transition-all">
          Terima kasih telah bergabung dalam Malega Circle.
        </div>
      </form>

    </div>

  </div>
</section>
