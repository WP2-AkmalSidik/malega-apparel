---
---

<section class="relative min-h-[92vh] sm:min-h-screen flex items-center pt-28 pb-20 sm:pt-36 sm:pb-28 overflow-hidden bg-[#0B132B]">
  <!-- Subtle Ambient Glows -->
  <div class="absolute top-1/4 right-1/4 w-[500px] h-[500px] bg-[#CBAC70]/5 blur-[160px] rounded-full pointer-events-none"></div>
  <div class="absolute bottom-10 left-10 w-[400px] h-[400px] bg-[#111C3D]/60 blur-[140px] rounded-full pointer-events-none"></div>

  <div class="max-w-[1440px] mx-auto px-6 sm:px-8 lg:px-12 w-full relative z-10">
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      
      <!-- Left Column: Editorial Statement & CTAs -->
      <div class="lg:col-span-7 space-y-8 text-left">
        
        <!-- Eyebrow Tag -->
        <div class="inline-flex items-center gap-3">
          <span class="w-8 h-[1px] bg-[#CBAC70]"></span>
          <span class="text-[11px] sm:text-xs font-semibold tracking-[0.25em] text-[#CBAC70] uppercase">
            Contemporary Apparel & Lifestyle
          </span>
        </div>

        <!-- Main Editorial Headline with Plus Jakarta Sans -->
        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-bold tracking-tight text-[#FDFCFF] leading-[1.08]">
          Everyday Form. <br />
          <span class="gold-gradient-text">Elevated.</span>
        </h1>

        <!-- Supporting Subtitle Copy -->
        <p class="text-base sm:text-lg text-[#8E9BAE] max-w-xl font-normal leading-relaxed">
          Malega menghadirkan busana kontemporer dengan proporsi terukur, kenyamanan esensial, dan karakter abadi — dirancang untuk menemani setiap babak perjalanan Anda.
        </p>

        <!-- CTAs -->
        <div class="flex flex-wrap items-center gap-4 pt-2">
          <a
            href="#collections"
            class="px-8 py-4 bg-[#CBAC70] hover:bg-[#E6D3A7] text-[#0B132B] font-semibold text-xs uppercase tracking-[0.2em] transition-all duration-300 rounded-sm shadow-md hover:shadow-[#CBAC70]/20 flex items-center gap-2 group"
          >
            <span>Explore Collection</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>

          <a
            href="#statement"
            class="px-7 py-4 border border-[#CBAC70]/30 hover:border-[#CBAC70] bg-[#0B132B]/40 hover:bg-[#0E1736] text-[#FDFCFF] font-semibold text-xs uppercase tracking-[0.2em] transition-all duration-300 rounded-sm"
          >
            Discover Malega
          </a>
        </div>

        <!-- Subtle 3 Key Pillars -->
        <div class="grid grid-cols-3 gap-6 pt-10 border-t border-[#CBAC70]/15 max-w-lg">
          <div class="space-y-1">
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-[#CBAC70]">
              Silhouettes
            </p>
            <p class="text-xs text-[#8E9BAE]">
              Relaxed & Tailored
            </p>
          </div>
          <div class="space-y-1">
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-[#CBAC70]">
              Materials
            </p>
            <p class="text-xs text-[#8E9BAE]">
              Dense Combed Weaves
            </p>
          </div>
          <div class="space-y-1">
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-[#CBAC70]">
              Versatility
            </p>
            <p class="text-xs text-[#8E9BAE]">
              Daily to Moments
            </p>
          </div>
        </div>

      </div>

      <!-- Right Column: Asymmetrical Editorial Photography Composition -->
      <div class="lg:col-span-5 relative">
        <div class="relative mx-auto max-w-md lg:max-w-none">
          
          <!-- Editorial Photo Frame -->
          <div class="relative aspect-[3/4] sm:aspect-[4/5] rounded-sm overflow-hidden bg-[#0E1736] border border-[#CBAC70]/25 shadow-2xl group">
            <img
              src="https://images.unsplash.com/photo-1521572267360-ee0c2909d518?w=1000&auto=format&fit=crop&q=85"
              alt="Malega Apparel Editorial Campaign - Everyday Form Elevated"
              class="w-full h-full object-cover object-top transition-transform duration-1000 ease-out group-hover:scale-105"
              loading="eager"
              width="800"
              height="1000"
            />
            
            <!-- Subtle Vignette & Gradient Overlay -->
            <div class="absolute inset-0 bg-gradient-to-t from-[#0B132B]/80 via-transparent to-transparent pointer-events-none"></div>

            <!-- Floating Label in Corner -->
            <div class="absolute bottom-6 left-6 right-6 flex items-end justify-between z-10">
              <div class="space-y-0.5">
                <span class="text-[10px] font-semibold text-[#CBAC70] uppercase tracking-[0.25em] block">
                  EDITORIAL SERIES
                </span>
                <p class="text-sm font-semibold text-[#FDFCFF]">
                  Signature Boxy & Modest Essentials
                </p>
              </div>

              <span class="text-xs font-mono text-[#CBAC70]">
                01/26
              </span>
            </div>
          </div>

          <!-- Secondary Accent Box (Asymmetrical Overlay) -->
          <div class="absolute -bottom-6 -left-6 hidden sm:block bg-[#0B132B]/95 backdrop-blur-md border border-[#CBAC70]/30 p-4 rounded-sm shadow-xl max-w-[200px]">
            <span class="text-[10px] uppercase font-semibold tracking-[0.2em] text-[#CBAC70] block">
              CRAFTED IN INDONESIA
            </span>
            <p class="text-xs text-[#FDFCFF] font-medium mt-1">
              Thoughtful design for every chapter.
            </p>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>
