---
import { CATEGORIES } from '../../data/categories';
import SectionHeading from '../ui/SectionHeading.astro';
---

<section id="categories" class="py-16 sm:py-24 lg:py-32 bg-[#0B132B] relative border-t border-[#CBAC70]/10">
  <div class="max-w-[1440px] mx-auto px-5 sm:px-8 lg:px-12 space-y-8 sm:space-y-16">
    
    <!-- Section Heading -->
    <SectionHeading
      eyebrow="02 / Category Exploration"
      title="Shop by Category"
      subtitle="Koleksi busana terstruktur yang dirancang untuk melengkapi kebutuhan rotasi pakaian harian Anda."
      align="split"
      linkText="Browse Catalog"
      linkHref="#new-arrivals"
    />

    <!-- Category Grid (6 Items: 2 Columns Mobile, 3 Columns Desktop) -->
    <div class="grid grid-cols-2 md:grid-cols-3 gap-3 sm:gap-6 lg:gap-8">
      {CATEGORIES.map((category) => (
        <a
          href={category.href}
          class="group relative aspect-[4/5] overflow-hidden rounded-sm bg-[#0E1736] border border-[#CBAC70]/15 hover:border-[#CBAC70]/40 transition-colors duration-500 block"
          aria-label={`Explore category ${category.name}`}
        >
          <!-- Background Image -->
          <img
            src={category.image}
            alt={category.alt}
            loading="lazy"
            class="w-full h-full object-cover object-top transition-transform duration-700 ease-out group-hover:scale-105"
            width="600"
            height="800"
          />

          <!-- Gradient Overlay -->
          <div class="absolute inset-0 bg-gradient-to-t from-[#0B132B] via-[#0B132B]/40 to-transparent opacity-85 group-hover:opacity-75 transition-opacity duration-500" />

          <!-- Category Information -->
          <div class="absolute inset-0 p-3.5 sm:p-6 lg:p-8 flex flex-col justify-between z-10">
            <div class="flex justify-end">
              <span class="text-[9px] sm:text-[10px] font-mono uppercase tracking-widest text-[#8E9BAE] group-hover:text-[#CBAC70] transition-colors">
                {category.itemCount}
              </span>
            </div>

            <div class="space-y-1 sm:space-y-1.5">
              <h3 class="text-sm sm:text-xl lg:text-2xl font-bold text-[#FDFCFF] group-hover:text-[#CBAC70] transition-colors leading-tight">
                {category.name}
              </h3>
              <p class="text-[10px] sm:text-xs text-[#8E9BAE] line-clamp-1">
                {category.subtitle}
              </p>
              
              <div class="pt-1 sm:pt-2">
                <span class="inline-flex items-center gap-1 sm:gap-1.5 text-[9px] sm:text-xs font-semibold uppercase tracking-[0.2em] text-[#CBAC70]">
                  <span>Explore</span>
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-3 h-3 sm:w-3.5 sm:h-3.5 transition-transform duration-300 group-hover:translate-x-1"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </span>
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>

  </div>
</section>
