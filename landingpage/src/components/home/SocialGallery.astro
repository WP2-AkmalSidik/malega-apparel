---
import { SOCIAL_GALLERY } from '../../data/editorial';
import SectionHeading from '../ui/SectionHeading.astro';
---

<section class="py-24 sm:py-32 bg-[#0B132B] relative border-t border-[#CBAC70]/10">
  <div class="max-w-[1440px] mx-auto px-6 sm:px-8 lg:px-12 space-y-16">
    
    <!-- Section Heading -->
    <SectionHeading
      eyebrow="07 / Visual Journey"
      title="Malega in Motion"
      subtitle="Eksplorasi visual, dokumentasi atelier, dan momen keseharian bersama komunitas Malega."
      align="split"
      linkText="Follow @malegaapparel"
      linkHref="https://instagram.com/malega.apparel"
    />

    <!-- Visual 6-Grid Gallery -->
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3 sm:gap-4">
      {SOCIAL_GALLERY.map((item) => (
        <a
          href="https://instagram.com/malega.apparel"
          target="_blank"
          rel="noopener noreferrer"
          class="group relative aspect-square overflow-hidden rounded-sm bg-[#0E1736] border border-[#CBAC70]/15 hover:border-[#CBAC70]/50 transition-colors duration-500 block"
          aria-label={item.caption}
        >
          <img
            src={item.image}
            alt={item.alt}
            loading="lazy"
            class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-110"
            width="400"
            height="400"
          />

          <!-- Gradient on Hover -->
          <div class="absolute inset-0 bg-gradient-to-t from-[#0B132B] via-[#0B132B]/40 to-transparent opacity-0 group-hover:opacity-90 transition-opacity duration-300 flex flex-col justify-end p-4 z-10">
            <span class="text-[9px] font-semibold text-[#CBAC70] uppercase tracking-[0.2em] block">
              {item.tag}
            </span>
            <p class="text-xs text-[#FDFCFF] font-medium leading-snug line-clamp-2">
              {item.caption}
            </p>
          </div>
        </a>
      ))}
    </div>

  </div>
</section>
