---
---

<section id="editorial" class="py-24 sm:py-32 bg-[#0B132B] relative overflow-hidden border-t border-[#CBAC70]/10">
  <div class="max-w-[1440px] mx-auto px-6 sm:px-8 lg:px-12">
    
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      
      <!-- Left Column: Large Editorial Image (60%) -->
      <div class="lg:col-span-7 relative">
        <div class="relative aspect-[16/10] sm:aspect-[16/11] rounded-sm overflow-hidden bg-[#0E1736] border border-[#CBAC70]/20 group">
          <img
            src="https://images.unsplash.com/photo-1503342217505-b0a15ec3261c?w=1200&auto=format&fit=crop&q=85"
            alt="The Malega Edit - Campaign Photography"
            loading="lazy"
            class="w-full h-full object-cover object-center transition-transform duration-1000 ease-out group-hover:scale-105"
            width="1200"
            height="825"
          />

          <!-- Gradient Overlay -->
          <div class="absolute inset-0 bg-gradient-to-t from-[#0B132B] via-transparent to-transparent opacity-60 pointer-events-none" />

          <div class="absolute bottom-6 left-6 right-6 flex items-center justify-between text-xs text-[#FDFCFF]">
            <span class="text-[10px] font-semibold text-[#CBAC70] uppercase tracking-[0.25em]">
              LOOKBOOK NO. 01 / SS26
            </span>
            <span class="text-[#8E9BAE] font-mono text-[11px]">
              OBSIDIAN & SAND STUDY
            </span>
          </div>
        </div>
      </div>

      <!-- Right Column: Editorial Narrative (40%) -->
      <div class="lg:col-span-5 space-y-8">
        
        <div class="space-y-2">
          <p class="text-[11px] font-semibold tracking-[0.25em] text-[#CBAC70] uppercase">
            The Malega Edit
          </p>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-[#FDFCFF] leading-[1.15]">
            Modern silhouettes. <br />
            Considered details. <br />
            <span class="gold-gradient-text">Made for everyday movement.</span>
          </h2>
        </div>

        <div class="space-y-4 text-sm sm:text-base text-[#8E9BAE] leading-relaxed font-normal">
          <p>
            Setiap busana dalam Malega Edit dirancang dengan perhatian mendalam terhadap siluet bahu turun, jatuhan kain yang rapi, dan keseimbangan tekstur.
          </p>
          <p>
            Bukan sekadar pakaian santai, namun busana esensial yang meningkatkan rasa percaya diri dalam kesederhanaan.
          </p>
        </div>

        <div class="pt-4 border-t border-[#CBAC70]/15 flex items-center gap-8">
          <div>
            <p class="text-2xl font-bold text-[#CBAC70] font-sans">100%</p>
            <p class="text-xs text-[#8E9BAE] uppercase tracking-wider mt-0.5">Combed Cotton</p>
          </div>
          <div class="w-[1px] h-10 bg-[#CBAC70]/20"></div>
          <div>
            <p class="text-2xl font-bold text-[#CBAC70] font-sans">Clean</p>
            <p class="text-xs text-[#8E9BAE] uppercase tracking-wider mt-0.5">Double Rib Finish</p>
          </div>
          <div class="w-[1px] h-10 bg-[#CBAC70]/20"></div>
          <div>
            <p class="text-2xl font-bold text-[#CBAC70] font-sans">Neutral</p>
            <p class="text-xs text-[#8E9BAE] uppercase tracking-wider mt-0.5">Earth Tone Palettes</p>
          </div>
        </div>

      </div>

    </div>

  </div>
</section>
