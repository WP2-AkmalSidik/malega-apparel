---
---

<section class="relative pt-12 pb-20 sm:pt-20 sm:pb-32 overflow-hidden">
  <!-- Ambient Gold Glow Backdrops -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[700px] bg-[#CBAC70]/10 blur-[180px] rounded-full pointer-events-none"></div>
  <div class="absolute top-1/3 right-10 w-[500px] h-[500px] bg-[#14204A]/50 blur-[150px] rounded-full pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Column: Headlines & High-Converting CTAs -->
      <div class="lg:col-span-7 space-y-6 sm:space-y-8 text-left">
        
        <!-- Live Capsule Release Pill -->
        <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full bg-[#14204A] border border-[#CBAC70]/40 text-[#CBAC70] text-[11px] sm:text-xs font-bold font-mono tracking-widest uppercase shadow-md">
          <span class="w-2 h-2 rounded-full bg-[#CBAC70] animate-ping"></span>
          <span>SS26 CAPSULE DROP : THE OBSIDIAN ESSENTIALS</span>
        </div>

        <!-- Main H1 Editorial Headline (SEO Optimized) -->
        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black tracking-tight leading-[1.05]">
          Redefining <span class="gold-gradient-text">Streetwear</span> with <span class="gold-gradient-pure">300GSM Cotton.</span>
        </h1>

        <!-- Subtitle Description -->
        <p class="text-base sm:text-lg text-[#94A3B8] max-w-xl font-normal leading-relaxed">
          Koleksi busana streetwear berkarakter kuat dengan material katun combed murni 300GSM, potongan boxy drop-shoulder presisi, dan konstruksi kerah ganda anti-melar.
        </p>

        <!-- Action CTAs -->
        <div class="flex flex-wrap items-center gap-4 pt-2">
          <a
            href="http://localhost:3000"
            class="px-8 py-4 rounded-xl bg-gradient-to-r from-[#E3CD99] via-[#CBAC70] to-[#A58645] text-[#0B132B] font-black text-xs uppercase tracking-widest hover:opacity-95 transition-all shadow-xl hover:shadow-[#CBAC70]/20 flex items-center gap-2 active:scale-95"
          >
            <span>Beli di Official Store</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14"></path>
              <path d="m12 5 7 7-7 7"></path>
            </svg>
          </a>

          <a
            href="#craftsmanship"
            class="px-7 py-4 rounded-xl bg-[#0E1736] hover:bg-[#14204A] text-[#FDFCFF] border border-[#CBAC70]/30 font-bold text-xs uppercase tracking-wider transition-all active:scale-95"
          >
            <span>Standard 300GSM</span>
          </a>
        </div>

        <!-- 3 Quick Proof Points -->
        <div class="grid grid-cols-3 gap-6 pt-8 border-t border-white/10 w-full max-w-lg">
          <div>
            <p class="text-2xl sm:text-3xl font-black text-[#CBAC70]">300<span class="text-sm font-bold text-white">GSM</span></p>
            <p class="text-xs text-[#94A3B8] mt-0.5 font-medium">Heavy Combed Cotton</p>
          </div>
          <div>
            <p class="text-2xl sm:text-3xl font-black text-[#CBAC70]">100<span class="text-sm font-bold text-white">%</span></p>
            <p class="text-xs text-[#94A3B8] mt-0.5 font-medium">Bespoke Cut & Sew</p>
          </div>
          <div>
            <p class="text-2xl sm:text-3xl font-black text-[#CBAC70]">4.9<span class="text-sm font-bold text-white">★</span></p>
            <p class="text-xs text-[#94A3B8] mt-0.5 font-medium">1.4k+ Verified Reviews</p>
          </div>
        </div>

      </div>

      <!-- Right Column: Visual Product Showcase with Double-Wrapped Card -->
      <div class="lg:col-span-5 relative">
        <div class="relative mx-auto max-w-md lg:max-w-none">
          
          <!-- Outer Card Packaging -->
          <div class="rounded-3xl bg-gradient-to-b from-[#14204A] via-[#0E1736] to-[#0A1024] p-3 border border-[#CBAC70]/35 shadow-2xl group">
            
            <!-- Inner Card Canvas -->
            <div class="rounded-2xl bg-[#070D1F] border border-white/10 overflow-hidden relative">
              
              <!-- Visual Image -->
              <div class="aspect-[4/5] bg-[#050914] overflow-hidden relative">
                <img
                  src="https://images.unsplash.com/photo-1521572267360-ee0c2909d518?w=900&auto=format&fit=crop&q=80"
                  alt="Malega Obsidian Heavyweight Boxy Tee 300GSM"
                  class="w-full h-full object-cover group-hover:scale-106 transition-transform duration-700 ease-out"
                  loading="eager"
                  width="700"
                  height="875"
                />
                
                <div class="absolute top-4 left-4 bg-[#CBAC70] text-[#0B132B] text-[10px] font-black tracking-widest uppercase px-3 py-1 rounded shadow">
                  SIGNATURE PIECE
                </div>
                
                <div class="absolute bottom-4 left-4 bg-[#0B132B]/90 border border-[#CBAC70]/30 backdrop-blur-md px-3 py-1 rounded-lg text-xs font-bold text-white">
                  300GSM • Double Rib 3.5cm
                </div>
              </div>

              <!-- Bottom Content inside Card -->
              <div class="p-5 space-y-3 bg-[#070D1F]">
                <div class="flex justify-between items-start">
                  <div>
                    <h3 class="font-black text-base text-[#FDFCFF]">
                      Obsidian Heavyweight Boxy Tee
                    </h3>
                    <p class="text-xs text-[#94A3B8]">Onyx Black • Drop Shoulder Fit</p>
                  </div>
                  <span class="text-lg font-black text-[#CBAC70] gold-gradient-pure">
                    Rp 229.000
                  </span>
                </div>

                <a
                  href="http://localhost:3000/products/mlg-001"
                  class="w-full py-3 bg-[#14204A] hover:bg-[#CBAC70] text-[#CBAC70] hover:text-[#0B132B] border border-[#CBAC70]/40 rounded-xl font-bold text-xs uppercase tracking-wider flex items-center justify-center gap-2 transition-all shadow active:scale-98"
                >
                  <span>Beli Sekarang di Store</span>
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 12h14"></path>
                    <path d="m12 5 7 7-7 7"></path>
                  </svg>
                </a>
              </div>

            </div>

          </div>
        </div>
      </div>

    </div>
  </div>
</section>
