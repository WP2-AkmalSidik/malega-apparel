---
---

<section class="relative pt-36 pb-24 lg:pt-44 lg:pb-32 overflow-hidden">
  <!-- Ambient background glow -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-amber-500/10 blur-[130px] rounded-full pointer-events-none"></div>
  <div class="absolute top-1/3 right-10 w-[400px] h-[400px] bg-orange-600/10 blur-[140px] rounded-full pointer-events-none"></div>
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Text Column -->
      <div class="lg:col-span-7 flex flex-col items-start space-y-6 text-left">
        <!-- Release Tag -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-slate-900/90 border border-amber-500/30 text-amber-400 text-xs font-semibold tracking-wide badge-glow">
          <span class="inline-block w-2 h-2 rounded-full bg-amber-400 animate-ping"></span>
          NEW DROP: THE OBSIDIAN ESSENTIALS 2026
        </div>

        <!-- Headline -->
        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight font-['Space_Grotesk'] leading-[1.08]">
          Redefining <span class="text-gradient">Urban Silhouette</span> with <span class="accent-gradient">Heavyweight Comfort.</span>
        </h1>

        <!-- Subheadline -->
        <p class="text-base sm:text-lg text-slate-400 max-w-xl font-normal leading-relaxed">
          Koleksi streetwear premium yang dirancang dengan material katun combed 300GSM, potongan boxy presisi, dan jahitan berkekuatan tinggi untuk ketahanan serta estetika kontemporer.
        </p>

        <!-- CTA Action Buttons -->
        <div class="flex flex-wrap items-center gap-4 pt-2 w-full sm:w-auto">
          <a 
            href="#featured" 
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-xl bg-amber-400 text-black font-bold text-sm hover:bg-amber-300 transition-all duration-200 shadow-lg shadow-amber-500/20 active:scale-95"
          >
            Jelajahi Koleksi
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>

          <a 
            href="#lookbook" 
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl border border-slate-700 bg-slate-900/50 hover:bg-slate-800 text-slate-200 font-semibold text-sm transition-all duration-200 active:scale-95"
          >
            Lihat Lookbook
          </a>
        </div>

        <!-- Stats / Proof points -->
        <div class="grid grid-cols-3 gap-6 pt-6 border-t border-slate-800/80 w-full">
          <div>
            <p class="text-2xl sm:text-3xl font-extrabold text-white font-['Space_Grotesk']">300<span class="text-amber-400 text-lg">GSM</span></p>
            <p class="text-xs text-slate-400 font-medium mt-0.5">Heavyweight Cotton</p>
          </div>
          <div>
            <p class="text-2xl sm:text-3xl font-extrabold text-white font-['Space_Grotesk']">100<span class="text-amber-400 text-lg">%</span></p>
            <p class="text-xs text-slate-400 font-medium mt-0.5">Custom Cut & Sew</p>
          </div>
          <div>
            <p class="text-2xl sm:text-3xl font-extrabold text-white font-['Space_Grotesk']">4.9<span class="text-amber-400 text-lg">★</span></p>
            <p class="text-xs text-slate-400 font-medium mt-0.5">Customer Rating</p>
          </div>
        </div>
      </div>

      <!-- Visual Showcase Column -->
      <div class="lg:col-span-5 relative">
        <div class="relative mx-auto max-w-md lg:max-w-none">
          <!-- Glass card container -->
          <div class="relative glass-panel rounded-3xl p-6 shadow-2xl overflow-hidden group">
            <!-- Simulated Apparel Visual Showcase -->
            <div class="aspect-[4/5] rounded-2xl bg-gradient-to-tr from-slate-950 via-slate-900 to-slate-800 relative overflow-hidden flex flex-col justify-between p-6 border border-slate-800">
              <div class="flex justify-between items-start">
                <span class="px-3 py-1 rounded-full text-[11px] font-bold bg-amber-500 text-black uppercase tracking-wider">
                  Limited Drop
                </span>
                <span class="text-xs font-mono text-slate-400">#MLG-2026-01</span>
              </div>

              <!-- Apparel Silhouette Graphic Center -->
              <div class="my-auto text-center py-8">
                <div class="inline-block p-8 rounded-full bg-slate-800/40 border border-slate-700/50 mb-4 group-hover:scale-110 transition-transform duration-500">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-20 h-20 text-amber-400 opacity-90" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                  </svg>
                </div>
                <h3 class="text-xl font-bold text-white font-['Space_Grotesk']">Obsidian Oversized Boxy Tee</h3>
                <p class="text-xs text-slate-400 mt-1">Deep Onyx Wash • Drop Shoulder Cut</p>
              </div>

              <div class="flex items-center justify-between pt-4 border-t border-slate-800/80">
                <div>
                  <span class="text-xs text-slate-400 block">Harga Spesial</span>
                  <span class="text-lg font-bold text-amber-400 font-['Space_Grotesk']">Rp 289.000</span>
                </div>
                <button class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-xs font-semibold text-white transition-colors">
                  Quick View
                </button>
              </div>
            </div>

            <!-- Floating Mini Badge -->
            <div class="absolute -bottom-2 -left-2 glass-panel px-4 py-2.5 rounded-2xl flex items-center gap-3 shadow-xl border border-slate-700/50">
              <div class="w-8 h-8 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold text-xs">
                ✓
              </div>
              <div>
                <p class="text-xs font-bold text-white">Ready Stock</p>
                <p class="text-[10px] text-slate-400">Siap kirim ke seluruh ID</p>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
